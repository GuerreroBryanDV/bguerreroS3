<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="bguerreroS3.Views.vLogin"
             Title="vLogin">
    <VerticalStackLayout
        Padding="30,40"
        Spacing="30">

        <Label 
            Text="INICIO DE SESIÓN"
            FontSize="20"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <!--IMAGENES-->
        <!--1 Enalce web (jpg/png)-->
        <!--2 Archivo jpg png dentro de los recursos-->



        <Image
            Source="iconologin.jpg"
            WidthRequest="150"
            HeightRequest="150"
            Margin="0,10"
          />


        <Grid HorizontalOptions="Center"
              VerticalOptions="Center"
              RowSpacing="20"
              ColumnSpacing="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label 
                Text="Usuario: "
                FontSize="18"
                Grid.Row="0"
                Grid.Column="0"
                VerticalOptions="Center" 
                HorizontalOptions="End" />
            <Entry 
                x:Name="txtUsuario"
                Placeholder="Ingrese su usuario"
                WidthRequest="220"
                Grid.Row="0"
                Grid.Column="1"
                VerticalOptions="Center" 
                HorizontalOptions="Start" />

            <Label Text="Contraseña: "
                FontSize="18"
                Grid.Row="1"
                Grid.Column="0"
                VerticalOptions="Center" 
                HorizontalOptions="End" />
            <Entry 
                x:Name="txtContrasena"
                Placeholder="Ingrese su contraseña"
                WidthRequest="220"
                Grid.Row="1"
                Grid.Column="1"
                IsPassword="True"
                VerticalOptions="Center" 
                HorizontalOptions="Start" />

            <Button x:Name="btnIniciarSesion"
                    Text="Inciar sesion"
                    Clicked="btnIniciarSesion_Clicked"
                    Margin="0,15,0,0"
                    Grid.Row="2"
                    Grid.Column="0"/>

            <Button x:Name="btnRegistrarUsuario"
                    Text="Registrar Usuario"
                    Clicked="btnRegistrarUsuario_Clicked"
                    Margin="0,15,0,0"
                    Grid.Row="2"
                    Grid.Column="1"/>


        </Grid>

    </VerticalStackLayout>
</ContentPage>