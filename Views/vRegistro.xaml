<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="bguerreroS3.Views.vRegistro"
             Title="vRegistro">
    <VerticalStackLayout
        Spacing="20"
        Padding="20">
        <Label 
            Text="Registrar Usuario"
            FontSize="20"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Entry x:Name="txtUsuarioNuevo"
               Placeholder="Ingresda usuario nuevo"/>

        <Entry x:Name="txtContrasenaNueva"
               Placeholder="Ingresa la contraseña"/>

        <Grid ColumnSpacing="15">
            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnGuardarUsuario"
                    Text="Guardar Usuario"
                    Clicked="btnGuardarUsuario_Clicked"
                    Grid.Row="0"
                    Grid.Column="0"
                    />

            <Button x:Name="btnCancelarUsuario"
                    Text="Cancelar"
                    Clicked="btnCancelarUsuario_Clicked"
                    Grid.Row="0"
                    Grid.Column="1"
                    />
        </Grid>
    </VerticalStackLayout>
</ContentPage>